FROM python:3.12-slim

# ----- pip 네트워크 안정화 기본값 -----
ENV PIP_DEFAULT_TIMEOUT=300 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and source code
COPY pyproject.toml ./
COPY common/ ./common/
COPY farmer/ ./farmer/
COPY teacher/ ./teacher/

RUN python -m pip install -U pip setuptools wheel && \
    pip install --no-cache-dir --timeout 300 --retries 10 -e .
    # 필요 시 아래 옵션 추가 (보안상 장기 사용 비권장)
    # --trusted-host pypi.org --trusted-host files.pythonhosted.org
    
# Install Python dependencies
RUN pip install --no-cache-dir -e .

# Copy remaining application code
COPY . /deps/LLM-T
ENV PYTHONPATH="/deps/LLM-T"

# Create non-root user
RUN useradd --create-home --shell /bin/bash app
RUN chown -R app:app /app /deps
USER app

# Expose port
EXPOSE 8000

# Run the authentication service
CMD ["python", "-m", "uvicorn", "common.main:app", "--host", "0.0.0.0", "--port", "8000"]
