FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# (선택) healthcheck용 curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 의존성 설치 (uv + 루트 락파일로 버전 고정, auth 전용 requirements만 설치)
COPY pyproject.toml uv.lock /app/
COPY auth/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir uv \
    && uv pip install --system --no-cache-dir -r /app/requirements.txt

# Auth 코드 및 마이그레이션 파일 복사
COPY auth/ /app/auth
COPY alembic/ /app/alembic
COPY alembic.ini /app/alembic.ini


EXPOSE 8000
ENV PYTHONPATH=/app
CMD ["uvicorn", "auth.main:app", "--host","0.0.0.0","--port","8000","--reload"]
